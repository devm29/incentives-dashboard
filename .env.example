# Copy to .env (or export these) and adjust. Every value is optional: unset
# variables fall back to the defaults in graphql/settings.py.

# Required in any deployment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# "sample" serves deterministic demo data with no network; "graphql" queries
# GRAPHQL_API_URL.
INCENTIVES_SOURCE=sample
GRAPHQL_API_URL=https://api.taomarketcap.com/graphql
GRAPHQL_SUBNET_UID=18
GRAPHQL_REQUEST_TIMEOUT=10
GRAPHQL_MAX_RETRIES=2
GRAPHQL_RETRY_BACKOFF=0.5

INCENTIVES_TOP_N=6
INCENTIVES_CACHE_TTL=300

# Leave empty for a per-process cache; set to share it across workers.
REDIS_URL=

# Optional written summary. Without a key the computed summary is shown.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_SUMMARY_ENABLED=True

LOG_LEVEL=INFO
